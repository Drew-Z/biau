# Blog draft model channels. Keep real relay URLs and API keys in .env.local.
# Prefer `npm run blog:model -- setup` for the guided three-profile wizard.
# Temperature is advanced/optional; defaults are shown only for reference.
# Optional request timeout for long draft/review calls, in milliseconds.
BLOG_DRAFT_REQUEST_TIMEOUT_MS=300000
# Long draft polishing defaults to section-level calls to avoid relay timeouts.
# Set to full only when you intentionally want one monolithic review call.
BLOG_DRAFT_POLISH_MODE=sections

# Default channel used as a shared fallback by `npm run blog:draft -- --generate`.
BLOG_DRAFT_BASE_URL=
BLOG_DRAFT_API_KEY=
BLOG_DRAFT_MODEL=
BLOG_DRAFT_PROVIDER=
BLOG_DRAFT_TEMPERATURE=0.65

# Generation profile selected with `--profile strong` or BLOG_DRAFT_PROFILE=strong.
# Recommended model: GLM-5.2 or Gemini 3.1 Pro.
BLOG_DRAFT_STRONG_BASE_URL=
BLOG_DRAFT_STRONG_API_KEY=
BLOG_DRAFT_STRONG_MODEL=glm-5.2-or-gemini-3.1-pro
BLOG_DRAFT_STRONG_PROVIDER=generation-relay
BLOG_DRAFT_STRONG_TEMPERATURE=0.65

# Optional same-profile fallback channels. Configure through
# `npm run blog:model -- setup --profile strong --fallback` when possible.
BLOG_DRAFT_STRONG_FALLBACK_1_BASE_URL=
BLOG_DRAFT_STRONG_FALLBACK_1_API_KEY=
BLOG_DRAFT_STRONG_FALLBACK_1_MODEL=glm-5.2-or-gemini-3.1-pro
BLOG_DRAFT_STRONG_FALLBACK_1_PROVIDER=generation-relay-backup
BLOG_DRAFT_STRONG_FALLBACK_1_TEMPERATURE=0.65

# Fast helper profile for outlines, titles, summaries, and low-risk checks.
# Recommended model: Gemini 3.5 Flash.
BLOG_DRAFT_FAST_BASE_URL=
BLOG_DRAFT_FAST_API_KEY=
BLOG_DRAFT_FAST_MODEL=gemini-3.5-flash
BLOG_DRAFT_FAST_PROVIDER=fast-relay
BLOG_DRAFT_FAST_TEMPERATURE=0.35

BLOG_DRAFT_FAST_FALLBACK_1_BASE_URL=
BLOG_DRAFT_FAST_FALLBACK_1_API_KEY=
BLOG_DRAFT_FAST_FALLBACK_1_MODEL=gemini-3.5-flash
BLOG_DRAFT_FAST_FALLBACK_1_PROVIDER=fast-relay-backup
BLOG_DRAFT_FAST_FALLBACK_1_TEMPERATURE=0.35

# Polishing profile selected with `--profile review` or BLOG_DRAFT_PROFILE=review.
# Recommended model: DeepSeek V4 Pro.
BLOG_DRAFT_REVIEW_BASE_URL=
BLOG_DRAFT_REVIEW_API_KEY=
BLOG_DRAFT_REVIEW_MODEL=deepseek-v4-pro
BLOG_DRAFT_REVIEW_PROVIDER=polish-relay
BLOG_DRAFT_REVIEW_TEMPERATURE=0.2

BLOG_DRAFT_REVIEW_FALLBACK_1_BASE_URL=
BLOG_DRAFT_REVIEW_FALLBACK_1_API_KEY=
BLOG_DRAFT_REVIEW_FALLBACK_1_MODEL=deepseek-v4-pro
BLOG_DRAFT_REVIEW_FALLBACK_1_PROVIDER=polish-relay-backup
BLOG_DRAFT_REVIEW_FALLBACK_1_TEMPERATURE=0.2

# Legacy fallback for older blog draft scripts/configs.
GEMINI_BASE_URL=http://localhost:8317
GEMINI_API_KEY=
GEMINI_MODEL=gemini
GEMINI_TEMPERATURE=0.65
VITE_OZON_ERP_URL=https://erp.ciallobill.qzz.io
# Public assistant frontend API base. Use /api for Cloudflare Pages Functions,
# or http://localhost:8787 / Render URL for the standalone Express API. The
# browser calls this server only; never expose model API keys through Vite vars.
VITE_CHAT_API_BASE_URL=/api
# Optional Content Studio API base. Defaults to VITE_CHAT_API_BASE_URL when
# unset. This is only the browser-facing backend URL, not a secret.
VITE_STUDIO_API_BASE_URL=
# Optional public AI Daily feed API base. It points to the Studio service
# origin but uses /public/ai-daily/*, never /studio/api/* or a browser token.
VITE_AI_DAILY_API_BASE_URL=
# Cloudflare Pages Function -> Render public assistant proxy. This value is
# server-only in Cloudflare and must not use the VITE_ prefix.
PUBLIC_ASSISTANT_API_BASE_URL=
PUBLIC_ASSISTANT_PROXY_TIMEOUT_MS=55000
# Cloudflare Pages Function -> fixed approved Responses upstream. These are
# server-only bindings; set URL/key/token as encrypted secrets in production.
MODEL_RELAY_SHARED_TOKEN=
MODEL_RELAY_UPSTREAM_BASE_URL=
MODEL_RELAY_UPSTREAM_API_KEY=
MODEL_RELAY_FALLBACK_UPSTREAM_BASE_URL=
MODEL_RELAY_FALLBACK_UPSTREAM_API_KEY=
MODEL_RELAY_ALLOWED_MODELS=grok-4.5,gemini-3.1-pro-preview,gpt-4.1
MODEL_RELAY_TIMEOUT_MS=50000
ASSISTANT_MODEL_STRUCTURED_OUTPUTS_MODE=off
PUBLIC_ASSISTANT_DIRECT_MAX_OUTPUT_TOKENS=800
# Optional server-side/local export API base for `npm run studio:export`.
# If empty, the exporter can reuse VITE_STUDIO_API_BASE_URL. This is not a
# secret, but keep tokens in STUDIO_ADMIN_TOKEN / ADMIN_TOKEN.
STUDIO_EXPORT_API_BASE=

# Optional visitor analytics adapter. Leave empty to disable all event tracking.
# Supported values: umami, plausible, debug.
# Real site IDs, script URLs, or provider tokens should be configured in the
# analytics provider / Cloudflare Pages environment, not committed here.
VITE_ANALYTICS_PROVIDER=

PORT=8787
METRICS_ENABLED=false
AI_DAILY_OPERATIONS_METRICS_ENABLED=false
DATABASE_URL=
# Optional dedicated Content Studio database. When set, /studio/api uses this
# Postgres database instead of DATABASE_URL, so assistant data and content drafts
# can be maintained separately.
STUDIO_DATABASE_URL=
CORS_ORIGIN=http://localhost:5173
TRUST_PROXY=false
# Explicit browser origins allowed to read the public AI Daily feed. Keep
# origins comma-separated, without paths or trailing slashes.
AI_DAILY_PUBLIC_CORS_ORIGINS=http://localhost:5173
AI_DAILY_TIME_ZONE=Asia/Shanghai
# Fail closed until the public-feed migration, CORS, and browser base are approved.
AI_DAILY_PUBLIC_FEED_ENABLED=false
AI_DAILY_PUBLIC_WINDOW_HOURS=72
AI_DAILY_PUBLIC_STALE_MINUTES=180
AI_DAILY_PUBLIC_RATE_LIMIT=60
AI_DAILY_PUBLIC_RATE_WINDOW_MS=60000
# Optional paid/limited news discovery primary. The token is injected only by
# the Studio ingestion runtime and must never be exposed through VITE_*.
AI_DAILY_THE_NEWS_API_ENABLED=false
AI_DAILY_THE_NEWS_API_TOKEN=
# Public no-key community signal. Only the original title, URL, and community
# source are retained; HotDaily-generated summaries and scores are discarded.
AI_DAILY_HOTDAILY_ENABLED=true
# Server-only three-role model runtime. Keep the JSON in Render secrets or an
# ignored local env file. Channels own credentials/failure domains; candidates
# map extractor/composer/verifier ids to channels. The normal static-selection
# path can use one candidate per role and explicitly records reduced redundancy;
# measured evaluation is an optional, separate business task that requires
# independent failure domains for a full-redundancy approval.
# Example shape (replace every placeholder only in the deployment environment):
# AI_DAILY_MODEL_RUNTIME_JSON={"schemaVersion":"ai-daily-model-runtime-v2","channels":[{"id":"relay-a","providerRef":"provider-a","failureDomainRef":"failure-a","protocol":"responses","baseUrl":"https://relay-a.example.com/v1","apiKey":"replace-in-deployment-env","modelIdentifier":"model-a"},{"id":"relay-b","providerRef":"provider-b","failureDomainRef":"failure-b","protocol":"responses","baseUrl":"https://relay-b.example.com/v1","apiKey":"replace-in-deployment-env","modelIdentifier":"model-b"}],"candidates":[{"candidateId":"extractor-a","role":"extractor","channelId":"relay-a"},{"candidateId":"extractor-b","role":"extractor","channelId":"relay-b"},{"candidateId":"composer-a","role":"composer","channelId":"relay-a"},{"candidateId":"composer-b","role":"composer","channelId":"relay-b"},{"candidateId":"verifier-a","role":"verifier","channelId":"relay-a"},{"candidateId":"verifier-b","role":"verifier","channelId":"relay-b"}]}
AI_DAILY_MODEL_RUNTIME_JSON=
# Optional measured evaluation requires --execute, this flag, and a matching
# approval id. Leave it empty when using the manual static-selection path.
AI_DAILY_BUSINESS_EVALUATION_ENABLED=false
AI_DAILY_MODEL_EVALUATION_APPROVAL_ID=
# Production generation additionally requires --live and a validated approved
# selection bundle. The file path and canonical bundle hash are both required,
# so a valid but stale Render Secret File cannot silently enter production.
AI_DAILY_PRODUCTION_GENERATION_ENABLED=false
# Render mounts the manually uploaded Secret File at
# /etc/secrets/ai-daily-model-approval.v1.json. Local paths must be absolute.
AI_DAILY_MODEL_APPROVAL_FILE=
AI_DAILY_MODEL_APPROVAL_BUNDLE_HASH=
ADMIN_TOKEN=change-me
# Optional owner-only Content Studio token. If empty, the backend falls back to
# ADMIN_TOKEN. Keep the real value in deployment env or .env.local.
STUDIO_ADMIN_TOKEN=
# Backend runtime boundary. Local development can leave this empty (`all`).
# Render final deployment creates three Web Services with explicit modes:
# public, studio, and rag.
ASSISTANT_SERVICE_MODE=all

# Public assistant model provider. Prefer these variables for the primary
# generation-model channel. Keep real relay URLs and API keys in deployment
# env or .env.local; `/chat/public` falls back to public knowledge if unset or
# if the provider fails. Do not put model keys in Vite variables.
# Production routes the approved Responses channel through the authenticated
# Cloudflare model relay because the provider rejects the Render egress.
ASSISTANT_MODEL_BASE_URL=https://biau.playlab.eu.cc/api/model-relay
ASSISTANT_MODEL_API_KEY=
ASSISTANT_MODEL_NAME=grok-4.5
ASSISTANT_MODEL_PROVIDER=cloudflare-model-relay
ASSISTANT_MODEL_PROTOCOL=responses

# Optional bounded fallback provider for final answer generation only. Models
# are tried in the listed order; empty/incomplete fallback settings are ignored.
# Keep at most two model names. No health check enumerates or probes them.
ASSISTANT_MODEL_FALLBACK_BASE_URL=https://biau.playlab.eu.cc/api/model-relay/fallback
ASSISTANT_MODEL_FALLBACK_API_KEY=
ASSISTANT_MODEL_FALLBACK_MODELS=gemini-3.1-pro-preview,gpt-4.1
ASSISTANT_MODEL_FALLBACK_PROVIDER=grok-4.5-channel-relay
# Image understanding is a bounded server-side tool call through one already
# configured fallback model. It does not add another credential or endpoint.
ASSISTANT_VISION_MODEL=gpt-4.1

# Optional server-side public RAG Orchestrator contract.
# Final deployment uses a separate ASSISTANT_SERVICE_MODE=rag service backed by
# the public Qdrant collection. The public service calls only this Orchestrator
# endpoint and must not connect to Qdrant directly. Never expose these values
# through Vite variables.
ASSISTANT_RAG_API_BASE_URL=
ASSISTANT_RAG_API_KEY=
ASSISTANT_RAG_TIMEOUT_MS=3000

# Anonymous public research assistant. DATABASE_URL stores only bounded public
# sessions, turns, feedback, and aggregate metrics; raw turns expire after at
# most 30 days. Operations/search credentials remain server-only.
PUBLIC_ASSISTANT_REQUEST_TIMEOUT_MS=45000
# Idle timeout between answer-stream provider events; the request timeout above
# remains the absolute run deadline.
PUBLIC_ASSISTANT_ANSWER_TIMEOUT_MS=20000
PUBLIC_ASSISTANT_VISION_TIMEOUT_MS=12000
PUBLIC_ASSISTANT_RATE_LIMIT=20
PUBLIC_ASSISTANT_RATE_WINDOW_MS=60000
PUBLIC_ASSISTANT_RETENTION_DAYS=30
PUBLIC_ASSISTANT_OPERATIONS_TOKEN=
# Supported pure-search adapters: tavily (default), brave, and exa. Tavily is
# pinned to Basic Search in code; keep every provider token server-only.
PUBLIC_WEB_SEARCH_PROVIDER=tavily
PUBLIC_WEB_SEARCH_BASE_URL=https://api.tavily.com
PUBLIC_WEB_SEARCH_API_KEY=
PUBLIC_WEB_SEARCH_TIMEOUT_MS=8000
PUBLIC_WEB_SEARCH_MAX_RESULTS=5
PUBLIC_WEB_FETCH_MAX_PAGES=3

# Standalone RAG Orchestrator. These are server-only Render variables for
# ASSISTANT_SERVICE_MODE=rag. Keep the real database URL and tokens private.
# Production: RAG_STORE_PROVIDER=supabase with a server-only RAG_DATABASE_URL.
# Local development can keep RAG_STORE_PROVIDER=local.
# RAG_SYNC_TOKEN authorizes versioned public-knowledge publication sync only.
RAG_STORE_PROVIDER=local
RAG_DATABASE_URL=
RAG_PUBLIC_API_KEY=
RAG_SYNC_TOKEN=

# Optional OpenAI-compatible embedding/reranker channels for external RAG sync
# and retrieval. Leave empty to use deterministic local embeddings for local
# tests. The production pgvector column is configured for qwen3-embedding-8b
# with exactly 4096 dimensions and uses exact cosine search.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=deterministic-local
EMBEDDING_DIMENSION=4096
EMBEDDING_TIMEOUT_MS=20000
RERANKER_BASE_URL=
RERANKER_API_KEY=
RERANKER_MODEL=
RERANKER_TIMEOUT_MS=10000

# Legacy compatibility: existing deployments that still use OPENAI_* continue
# to work, but new deployments should use ASSISTANT_MODEL_* above.
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
